{
  "info": {
    "name": "RecipeHub Enterprise - Automated API Tests",
    "description": "Run requests in order. Register automatically stores JWT; category/ingredient/recipe IDs are captured. Re-run: clear collection variable suffix or set a new value.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 Register",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "register"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"username\":\"rh{{suffix}}\",\"email\":\"rh{{suffix}}@example.com\",\"password\":\"StrongPassword123!\",\"fullName\":\"RecipeHub Tester\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.collectionVariables.get(\"suffix\")) pm.collectionVariables.set(\"suffix\", String(Date.now()));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "if (pm.response.code < 300) pm.collectionVariables.set(\"accessToken\", pm.response.json().accessToken);"
            ]
          }
        }
      ]
    },
